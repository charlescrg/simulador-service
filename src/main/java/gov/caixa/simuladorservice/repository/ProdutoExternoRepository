package gov.caixa.simuladorservice.repository;

import gov.caixa.simuladorservice.entity.produto.ProdutoExternoEntity;
import jakarta.enterprise.context.ApplicationScoped;
import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;
import jakarta.persistence.TypedQuery;

import java.util.List;

@ApplicationScoped
public class ProdutoExternoRepository {

    @PersistenceContext(unitName = "external")
    EntityManager em;

    public ProdutoExternoEntity findById(Integer id) {
        return em.find(ProdutoExternoEntity.class, id);
    }

    public List<ProdutoExternoEntity> listarTodos() {
        TypedQuery<ProdutoExternoEntity> query = em.createQuery("SELECT p FROM ProdutoExternoEntity p", ProdutoExternoEntity.class);
        return query.getResultList();
    }

    public void persist(ProdutoExternoEntity produto) {
        em.persist(produto);
    }
}
